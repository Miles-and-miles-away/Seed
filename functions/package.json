  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
