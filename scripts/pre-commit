#!/usr/bin/env bash
# Pre-commit hook: check dart format on staged files

staged=$(git diff --cached --name-only --diff-filter=ACM \
  | grep '\.dart$' \
  | grep -v '\.g\.dart$' \
  | grep -v '\.freezed\.dart$')

if [ -z "$staged" ]; then
  exit 0
fi

unformatted=$(echo "$staged" | xargs dart format --set-exit-if-changed --output=none 2>&1)

if [ $? -ne 0 ]; then
  echo "Unformatted Dart files detected. Run:"
  echo "  dart format ."
  exit 1
fi
