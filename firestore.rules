rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Password accounts must verify their email before gameplay writes.
    // Social providers arrive pre-verified. The user document itself is
    // created at registration (before verification), so this gate is
    // applied to actionLog and dailySummaries only.
    function isVerifiedUser() {
      return !('firebase' in request.auth.token)
          || request.auth.token.firebase.sign_in_provider != 'password'
          || request.auth.token.get('email_verified', false) == true;
    }

    // Scoring runs in a client transaction, so rules cannot prove a
    // points jump is earned -- authoritative anti-cheat would require
    // server-side scoring (deferred until cross-user features exist;
    // users are isolated today). What the rules below DO enforce:
    //   - field whitelist, types, and bounds on the user document
    //   - score fields never decrease and cannot be removed once set
    //   - points only grow as part of a well-formed action-log write
    //     (bounded jump, lastActionDate bumped to the server time,
    //     exactly one new action counted)
    //   - actionLog entries match the canonical actionLibrary points
    //     AND co2Grams, and must arrive in the same transaction as the
    //     matching user-doc update (blocks direct log floods)
    //   - a 5-second minimum interval between action submissions
    // Known residual gap: multiple identical creates batched into one
    // transaction share a single rules evaluation of the user doc, so
    // they can inflate the log history (not the aggregates). App Check
    // plus the coupling above keeps this low-value.
    //
    // Style note: Firestore caps a single rule evaluation at 1000
    // expressions. Update validation therefore checks only the changed
    // fields (request.resource.data.diff(resource.data).affectedKeys())
    // instead of re-validating the whole merged user document, so cost
    // stays bounded as a document accumulates fields over time.
    match /users/{userId} {

      // Whitelist plus type/bound checks for every field the app
      // writes; blocks junk-data floods. `d` is the merged post-write
      // document (Firestore evaluates update() against the merged
      // document, not the patch).
      // Field whitelist -- single source of truth for create + update.
      function userKeys() {
        return [
          'uid', 'email', 'displayName', 'photoUrl', 'personalGoal',
          'points', 'level', 'currentStreak', 'longestStreak',
          'language', 'notificationTime', 'createdAt', 'emailVerified',
          'dailyGoalTarget', 'mascots', 'activeMascotId', 'egg',
          'eggPendingDiscovery', 'eggPendingDiscoverySince',
          'notificationsEnabled', 'lastActionDate',
          'streakGracePeriodAvailable', 'fcmToken', 'totalCo2Grams',
          'totalActionsCount', 'sdgStats', 'viewedFactDates',
          'unlockedFactDates', 'challengeCompletedDate',
          'challengeStreak', 'challengesCompleted',
          'recentChallengeIds', 'activeMultiDayChallenge',
          'completedMultiDayChallenges', 'ecodexDiscovered',
          'uniqueActionIds', 'categoryActionCounts', 'settings',
          'lastStreakReminderDate'
        ];
      }

      // Type/bound check for each field, gated on the field appearing in
      // `keys`. Callers choose how many checks run: create passes the
      // whole key set (validate all); update passes only
      // diff().affectedKeys() so cost scales with the patch, not the
      // document -- this keeps evaluation under Firestore's 1000-
      // expression cap as an established user document grows. Values are
      // read from `d`, the merged post-write document.
      function userFieldsOk(d, keys) {
        return (!('uid' in keys) || d.uid == userId)
        // Empty email allowed: social providers can hide it and the
        // client then stores ''.
        && (!('email' in keys)
            || (d.email is string && d.email.size() <= 320))
        && (!('displayName' in keys) || d.displayName == null
            || (d.displayName is string && d.displayName.size() >= 1
                && d.displayName.size() <= 50))
        && (!('photoUrl' in keys) || d.photoUrl == null
            || (d.photoUrl is string && d.photoUrl.size() <= 2048))
        && (!('personalGoal' in keys) || d.personalGoal == null
            || (d.personalGoal is string && d.personalGoal.size() >= 1
                && d.personalGoal.size() <= 100))
        && (!('language' in keys) || d.language in ['en', 'es', 'ja'])
        && (!('notificationTime' in keys) || d.notificationTime == null
            || (d.notificationTime is string
                && d.notificationTime.size() <= 16))
        && (!('createdAt' in keys) || d.createdAt == null
            || d.createdAt is timestamp)
        && (!('emailVerified' in keys) || d.emailVerified is bool)
        && (!('dailyGoalTarget' in keys) || d.dailyGoalTarget == null
            || (d.dailyGoalTarget is int && d.dailyGoalTarget >= 1
                && d.dailyGoalTarget <= 100))
        && (!('mascots' in keys)
            || (d.mascots is list && d.mascots.size() <= 20))
        && (!('activeMascotId' in keys) || d.activeMascotId == null
            || (d.activeMascotId is string
                && d.activeMascotId.size() <= 100))
        && (!('egg' in keys) || d.egg == null
            || (d.egg is map
                && d.egg.keys().hasOnly(['receivedAt',
                    'hatchingStreakDays', 'lastHatchingActivityDate'])
                && 'receivedAt' in d.egg
                && d.egg.receivedAt is timestamp
                && d.egg.get('hatchingStreakDays', 0) is int
                && d.egg.get('hatchingStreakDays', 0) >= 0
                && d.egg.get('hatchingStreakDays', 0) <= 30
                && (d.egg.get('lastHatchingActivityDate', null) == null
                    || d.egg.lastHatchingActivityDate is timestamp)))
        && (!('eggPendingDiscovery' in keys)
            || d.eggPendingDiscovery is bool)
        && (!('eggPendingDiscoverySince' in keys)
            || d.eggPendingDiscoverySince == null
            || d.eggPendingDiscoverySince is timestamp)
        && (!('notificationsEnabled' in keys)
            || d.notificationsEnabled is bool)
        // Legacy field (removed from the model 2026-06-12); kept
        // writable so docs that still carry it pass hasOnly checks.
        && (!('streakGracePeriodAvailable' in keys)
            || d.streakGracePeriodAvailable is bool)
        && (!('fcmToken' in keys) || d.fcmToken == null
            || (d.fcmToken is string && d.fcmToken.size() <= 4096))
        && (!('points' in keys)
            || (d.points is int && d.points >= 0
                && d.points <= 1000000000))
        && (!('level' in keys)
            || (d.level is int && d.level >= 1 && d.level <= 1000))
        && (!('currentStreak' in keys)
            || (d.currentStreak is int && d.currentStreak >= 0
                && d.currentStreak <= 40000))
        && (!('longestStreak' in keys)
            || (d.longestStreak is int && d.longestStreak >= 0
                && d.longestStreak <= 40000))
        && (!('totalCo2Grams' in keys)
            || (d.totalCo2Grams is int && d.totalCo2Grams >= 0
                && d.totalCo2Grams <= 100000000000))
        && (!('totalActionsCount' in keys)
            || (d.totalActionsCount is int && d.totalActionsCount >= 0
                && d.totalActionsCount <= 10000000))
        && (!('lastActionDate' in keys) || d.lastActionDate == null
            || d.lastActionDate is timestamp)
        && (!('sdgStats' in keys) || d.sdgStats is map)
        && (!('viewedFactDates' in keys)
            || (d.viewedFactDates is list
                && d.viewedFactDates.size() <= 40000))
        && (!('unlockedFactDates' in keys)
            || (d.unlockedFactDates is list
                && d.unlockedFactDates.size() <= 40000))
        && (!('challengeCompletedDate' in keys)
            || (d.challengeCompletedDate is string
                && d.challengeCompletedDate.size() <= 10))
        && (!('challengeStreak' in keys)
            || (d.challengeStreak is int && d.challengeStreak >= 0
                && d.challengeStreak <= 40000))
        && (!('challengesCompleted' in keys)
            || (d.challengesCompleted is int
                && d.challengesCompleted >= 0
                && d.challengesCompleted <= 10000000))
        && (!('recentChallengeIds' in keys)
            || (d.recentChallengeIds is list
                && d.recentChallengeIds.size() <= 7))
        && (!('activeMultiDayChallenge' in keys)
            || d.activeMultiDayChallenge is map)
        && (!('completedMultiDayChallenges' in keys)
            || (d.completedMultiDayChallenges is list
                && d.completedMultiDayChallenges.size() <= 1000))
        && (!('ecodexDiscovered' in keys)
            || (d.ecodexDiscovered is list
                && d.ecodexDiscovered.size() <= 1000))
        && (!('uniqueActionIds' in keys)
            || (d.uniqueActionIds is list
                && d.uniqueActionIds.size() <= 2000))
        && (!('categoryActionCounts' in keys)
            || d.categoryActionCounts is map)
        && (!('settings' in keys) || d.settings is map)
        && (!('lastStreakReminderDate' in keys)
            || d.lastStreakReminderDate == null
            || (d.lastStreakReminderDate is string
                && d.lastStreakReminderDate.size() <= 10));
      }

      // Full-shape check for CREATE: the new document may contain only
      // whitelisted fields, all well-typed.
      function validUserShape(d) {
        return d.keys().hasOnly(userKeys())
            && userFieldsOk(d, d.keys());
      }

      // Gameplay-counter integrity on updates. `d` is the merged
      // post-write document, `old` the pre-write document.
      function userUpdateOk(d, old) {
        // Score fields cannot be removed once set: removal would allow
        // re-creating them at a lower value, bypassing the
        // never-decreases checks below.
        return (!('points' in old) || 'points' in d)
            && (!('level' in old) || 'level' in d)
            && (!('longestStreak' in old) || 'longestStreak' in d)
            && (!('totalCo2Grams' in old) || 'totalCo2Grams' in d)
            && (!('totalActionsCount' in old)
                || 'totalActionsCount' in d)
            && (!('challengesCompleted' in old)
                || 'challengesCompleted' in d)
            && (!('lastActionDate' in old) || 'lastActionDate' in d)
            && d.get('points', 0) >= old.get('points', 0)
            && d.get('level', 1) >= old.get('level', 1)
            && d.get('longestStreak', 0) >= old.get('longestStreak', 0)
            && d.get('totalCo2Grams', 0) >= old.get('totalCo2Grams', 0)
            && d.get('totalActionsCount', 0)
                >= old.get('totalActionsCount', 0)
            && d.get('challengesCompleted', 0)
                >= old.get('challengesCompleted', 0)
            && d.get('totalActionsCount', 0)
                - old.get('totalActionsCount', 0) <= 1
            // Bounded by the largest canonical per-action saving
            // (~3.4t) with generous headroom.
            && d.get('totalCo2Grams', 0)
                - old.get('totalCo2Grams', 0) <= 10000000
            // Points may only grow as part of an action-log shaped
            // write: bounded jump, lastActionDate bumped to now, and
            // exactly one new action counted.
            && (d.get('points', 0) == old.get('points', 0)
                || (d.get('points', 0) - old.get('points', 0) <= 10000
                    && d.get('lastActionDate', null) == request.time
                    && d.get('totalActionsCount', 0)
                        == old.get('totalActionsCount', 0) + 1))
            // lastActionDate is either untouched, or bumped to the
            // server time of this write with at least 5s since the
            // previous bump. The client writes it with
            // FieldValue.serverTimestamp(), which rules evaluate as
            // request.time.
            && (d.get('lastActionDate', null)
                    == old.get('lastActionDate', null)
                || (d.get('lastActionDate', null) == request.time
                    && (old.get('lastActionDate', null) == null
                        || request.time > old.lastActionDate
                            + duration.value(5, 's'))));
      }

      // Update-shape check: only whitelisted fields may change, and only
      // the changed fields are type-checked (cost scales with the diff,
      // not the document size -- see userFieldsOk).
      function validUserUpdate(d, old, changed) {
        return changed.hasOnly(userKeys())
            && userFieldsOk(d, changed)
            && userUpdateOk(d, old);
      }

      allow read: if isOwner(userId);

      // Created once at registration with zeroed gameplay state.
      allow create: if isOwner(userId)
          && validUserShape(request.resource.data)
          && request.resource.data.get('points', 0) == 0
          && request.resource.data.get('level', 1) == 1
          && request.resource.data.get('currentStreak', 0) == 0
          && request.resource.data.get('longestStreak', 0) == 0
          && request.resource.data.get('totalCo2Grams', 0) == 0
          && request.resource.data.get('totalActionsCount', 0) == 0
          && request.resource.data.get('challengeStreak', 0) == 0
          && request.resource.data.get('challengesCompleted', 0) == 0
          && request.resource.data.get('lastActionDate', null) == null;

      allow update: if isOwner(userId)
          && validUserUpdate(
               request.resource.data,
               resource.data,
               request.resource.data.diff(resource.data).affectedKeys());

      // Deletion happens via the deleteUserAccount Cloud Function
      // (Admin SDK bypasses rules and removes subcollections too).
      allow delete: if false;

      // Subcollection: action log
      match /actionLog/{logId} {

        // Single-call validation; `log` is the new entry, `userBefore`
        // and `userAfter` the user document around this transaction.
        function validLogCreate(log, userBefore, userAfter) {
          return log.keys().hasAll([
                 'actionId', 'actionName', 'category', 'points',
                 'loggedAt', 'co2Grams'])
            && log.keys().hasOnly([
                 'actionId', 'actionName', 'category', 'points',
                 'loggedAt', 'co2Grams', 'note', 'relatedSdgs'])
            && log.actionId is string
            && log.actionId.size() >= 1
            && log.actionId.size() <= 200
            && log.actionName is string
            && log.actionName.size() >= 1
            && log.actionName.size() <= 500
            && log.category is string
            && log.category.size() >= 1
            && log.category.size() <= 100
            && log.points is int
            && log.points >= 0
            && log.points <= 10000
            // Generous window: loggedAt is informational (aggregates
            // are validated separately), so tolerate clock skew while
            // blocking wholesale history fabrication.
            && log.loggedAt is timestamp
            && log.loggedAt > request.time - duration.value(24, 'h')
            && log.loggedAt < request.time + duration.value(24, 'h')
            && (!('note' in log)
                || log.note == null
                || (log.note is string && log.note.size() <= 200))
            && (!('relatedSdgs' in log)
                || (log.relatedSdgs is list
                    && log.relatedSdgs.size() <= 17))
            // Same-transaction coupling: the log must arrive with the
            // matching user-doc update (lastActionDate bumped to now,
            // exactly one new action counted). Blocks log creates
            // that bypass the scoring transaction.
            && userAfter.get('lastActionDate', null) == request.time
            && userAfter.get('totalActionsCount', 0)
                == userBefore.get('totalActionsCount', 0) + 1
            // Rate limit: 5s between submissions, measured against
            // the pre-transaction state.
            && (userBefore.get('lastActionDate', null) == null
                || request.time > userBefore.lastActionDate
                    + duration.value(5, 's'));
        }

        // Canonical values must match the action library exactly.
        function matchesLibrary(log, libraryAction) {
          return log.points == libraryAction.points
              && log.co2Grams is int
              && log.co2Grams >= 0
              && log.co2Grams == libraryAction.get('co2Grams', 0);
        }

        // Custom transport actions (Phase 8.6) are validated against
        // the user's own template instead of the read-only library:
        // the log's points and co2Grams must equal the template the
        // user created. No numeric ceiling -- users are isolated (no
        // leaderboards), so self-reported inflation only affects the
        // user's own stats. The existing per-write totalCo2Grams cap
        // on the user doc still bounds a single log.
        function matchesCustomAction(log, customAction) {
          return log.points == customAction.points
              && log.co2Grams is int
              && log.co2Grams >= 0
              && log.co2Grams == customAction.get('co2Grams', 0);
        }

        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
            && isVerifiedUser()
            && validLogCreate(
                 request.resource.data,
                 get(/databases/$(database)/documents/users
                     /$(userId)).data,
                 getAfter(/databases/$(database)/documents/users
                     /$(userId)).data)
            // A log must match EITHER a library action or one of the
            // user's own custom actions. The exists() guards make the
            // matching branch short-circuit, so the other branch never
            // dereferences a null document.
            && (
                 (exists(/databases/$(database)/documents/actionLibrary
                     /$(request.resource.data.actionId))
                  && matchesLibrary(
                       request.resource.data,
                       get(/databases/$(database)/documents/actionLibrary
                           /$(request.resource.data.actionId)).data))
                 ||
                 (exists(/databases/$(database)/documents/users/$(userId)
                     /customActions/$(request.resource.data.actionId))
                  && matchesCustomAction(
                       request.resource.data,
                       get(/databases/$(database)/documents/users/$(userId)
                           /customActions
                           /$(request.resource.data.actionId)).data))
               );

        // Immutable from the client; admin SDK bypasses rules.
        allow update, delete: if false;
      }

      // Subcollection: user-created transport actions (Phase 8.6).
      match /customActions/{actionId} {

        function validCustomAction(a) {
          return a.keys().hasAll(['name', 'co2Grams', 'points'])
            && a.keys().hasOnly([
                 'name', 'co2Grams', 'points', 'category',
                 'relatedSdgs', 'createdAt'])
            && a.name is string
            && a.name.size() >= 1
            && a.name.size() <= 500
            && a.co2Grams is int
            && a.co2Grams >= 0
            // Matches the actionLog points ceiling so a template that
            // could never be logged cannot be created.
            && a.points is int
            && a.points >= 0
            && a.points <= 10000
            && (!('category' in a)
                || (a.category is string && a.category.size() <= 100))
            && (!('relatedSdgs' in a)
                || (a.relatedSdgs is list && a.relatedSdgs.size() <= 17))
            && (!('createdAt' in a)
                || a.createdAt == null
                || a.createdAt is timestamp);
        }

        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
            && isVerifiedUser()
            && validCustomAction(request.resource.data);
        // Templates are logging fingerprints; editing one would let a
        // past log's fingerprint change. Recreate instead of edit.
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // Subcollection: daily summaries
      match /dailySummaries/{summaryId} {

        function validSummary(s) {
          return s.keys().hasOnly([
                 'date', 'goalCount', 'completedSdgs', 'totalPoints',
                 'totalCo2Grams', 'categoryCo2Grams', 'createdAt',
                 'updatedAt'])
            && s.get('date', '') == summaryId
            && s.get('goalCount', 0) is int
            && s.get('goalCount', 0) >= 0
            && s.get('goalCount', 0) <= 100000
            && s.get('totalPoints', 0) is int
            && s.get('totalPoints', 0) >= 0
            && s.get('totalPoints', 0) <= 100000000
            && s.get('totalCo2Grams', 0) is int
            && s.get('totalCo2Grams', 0) >= 0
            && s.get('totalCo2Grams', 0) <= 100000000
            && (!('completedSdgs' in s)
                || (s.completedSdgs is list
                    && s.completedSdgs.size() <= 17))
            && (!('categoryCo2Grams' in s) || s.categoryCo2Grams is map)
            && (!('createdAt' in s) || s.createdAt == null
                || s.createdAt is timestamp)
            && (!('updatedAt' in s) || s.updatedAt == null
                || s.updatedAt is timestamp);
        }

        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId)
            && isVerifiedUser()
            && summaryId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && validSummary(request.resource.data);

        allow delete: if false;
      }
    }

    // Action library is read-only for authenticated users
    match /actionLibrary/{actionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Mascot species are read-only
    match /mascotSpecies/{speciesId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Cosmetic items are read-only
    match /cosmeticItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
