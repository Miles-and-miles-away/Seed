rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own data
    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (!request.resource.data.keys().hasAny(['mascots'])
                       || request.resource.data.mascots.size() <= 20)
                   && (!request.resource.data.keys().hasAny(['language'])
                       || request.resource.data.language in ['en', 'es', 'ja'])
                   && (!request.resource.data.keys().hasAny(['displayName'])
                       || request.resource.data.displayName == null
                       || (request.resource.data.displayName is string
                           && request.resource.data.displayName.size() >= 1
                           && request.resource.data.displayName.size() <= 50))
                   && (!request.resource.data.keys().hasAny(['personalGoal'])
                       || request.resource.data.personalGoal == null
                       || (request.resource.data.personalGoal is string
                           && request.resource.data.personalGoal.size() >= 1
                           && request.resource.data.personalGoal.size() <= 100))
                   // Score integrity (defense-in-depth). Scoring runs in a
                   // client transaction, so these fields must stay client-
                   // writable -- rules cannot prove a points jump is earned.
                   // What they CAN enforce: correct types and that points /
                   // level never decrease (no resets or negative tampering).
                   // Authoritative anti-cheat still requires moving scoring
                   // server-side (Cloud Functions / admin SDK).
                   && (!request.resource.data.keys().hasAny(['points'])
                       || (request.resource.data.points is int
                           && request.resource.data.points >= 0
                           && (resource == null
                               || !resource.data.keys().hasAny(['points'])
                               || request.resource.data.points
                                   >= resource.data.points)))
                   && (!request.resource.data.keys().hasAny(['level'])
                       || (request.resource.data.level is int
                           && request.resource.data.level >= 1
                           && (resource == null
                               || !resource.data.keys().hasAny(['level'])
                               || request.resource.data.level
                                   >= resource.data.level)));

      // Subcollection: action log
      match /actionLog/{logId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasAll(
                           ['actionId', 'actionName',
                            'category', 'points',
                            'loggedAt', 'co2Grams']
                         )
                      && request.resource.data.points is int
                      && request.resource.data.points >= 0
                      && request.resource.data.points <= 10000
                      && request.resource.data.co2Grams is int
                      && request.resource.data.co2Grams >= 0
                      && request.resource.data.actionId is string
                      && request.resource.data.actionName is string
                      && request.resource.data.category is string
                      && request.resource.data.loggedAt is timestamp
                      && request.resource.data.points ==
                           get(/databases/$(database)/documents
                               /actionLibrary
                               /$(request.resource.data.actionId)
                           ).data.points
                      // Note field size limit
                      && (!request.resource.data.keys().hasAny(['note'])
                          || (request.resource.data.note is string
                              && request.resource.data.note.size() <= 200))
                      // Related SDGs array size limit
                      && (!request.resource.data.keys().hasAny(['relatedSdgs'])
                          || (request.resource.data.relatedSdgs is list
                              && request.resource.data.relatedSdgs.size() <= 17))
                      // Rate limit: 5s between submissions
                      && (
                        !exists(/databases/$(database)/documents/users/$(userId))
                        || !('lastActionDate' in get(/databases/$(database)/documents/users/$(userId)).data)
                        || request.time > get(/databases/$(database)/documents/users/$(userId)).data.lastActionDate + duration.value(5, 's')
                      );
        // Immutable from client; admin SDK bypasses rules
        allow update, delete: if false;
      }

      // Subcollection: daily summaries
      match /dailySummaries/{summaryId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;
        allow write: if request.auth != null
                     && request.auth.uid == userId;
      }
    }

    // Action library is read-only for authenticated users
    match /actionLibrary/{actionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Mascot species are read-only
    match /mascotSpecies/{speciesId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Cosmetic items are read-only
    match /cosmeticItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
